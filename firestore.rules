rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validTrial(uid, data) {
      return data.user_id == uid
        && data.plan_code == 'trial_7d'
        && data.status == 'trial'
        && data.trial_started_at == request.time
        && data.created_at == request.time
        && data.updated_at == request.time
        && data.keys().hasOnly([
          'user_id',
          'plan_code',
          'status',
          'trial_started_at',
          'created_at',
          'updated_at'
        ]);
    }

    match /meilan_admins/{uid} {
      // Cada cuenta solo puede comprobar su propio rol.
      // Nadie puede darse permisos de administrador desde la app.
      allow read: if isOwner(uid);
      allow create, update, delete: if false;
    }

    match /meilan_subscriptions/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validTrial(uid, request.resource.data);
      allow update, delete: if false;
    }

    match /meilan_payments/{paymentId} {
      allow read, write: if false;
    }
  }
}
