rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /meilan_admins/{uid} {
      // Cada cuenta solo puede comprobar su propio rol.
      // Nadie puede darse permisos de administrador desde la app.
      allow read: if isOwner(uid);
      allow create, update, delete: if false;
    }

    match /meilan_subscriptions/{uid} {
      // El cliente solo puede leer su estado.
      // Pruebas y pagos se escriben exclusivamente desde Cloud Functions.
      allow read: if isOwner(uid);
      allow create, update, delete: if false;
    }

    match /meilan_plans/{planId} {
      // Los planes se consultan y administran por Cloud Functions.
      allow read, write: if false;
    }

    match /meilan_checkouts/{checkoutId} {
      allow read, write: if false;
    }

    match /meilan_payments/{paymentId} {
      allow read, write: if false;
    }

    // Configuración privada del backend (incluye credenciales y metadatos internos).
    match /meilan_private/{document=**} {
      allow read, write: if false;
    }
  }
}
